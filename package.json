{
  "name": "bramble-and-pip",
  "version": "1.0.0",
  "private": true,
  "description": "A calm, non-addictive, offline-first nature-observation adventure for children under 7.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:playtesting": "playwright test tests/e2e/stochastic-touch.spec.ts",
    "audit:egress": "node scripts/audit-egress.mjs",
    "icons": "node scripts/make-icons.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "easystarjs": "^0.4.4",
    "pdfmake": "^0.2.20",
    "phaser": "^3.90.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/pdfmake": "^0.2.11",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "workbox-build": "^7.3.0"
  }
}
